#: src/pygpsclient/about_dialog.py:83
msgid "Function unavailable under Homebrew"
msgstr "Fonction non disponible sous Homebrew"

#: src/pygpsclient/about_dialog.py:85
msgid ""
"PyGPSClient is a free, open-source GNSS diagnostic and configuration "
"application written entirely by human volunteers in Python and tkinter. "
"It supports NMEA, UBX, SBF, UNI, QGC, RTCM3, NTRIP, SPARTN & RINEX "
"protocols."
msgstr ""
"PyGPSClient est une application gratuite et open source de diagnostic et "
"de configuration GNSS, entièrement écrite par des bénévoles en Python et "
"tkinter. Il prend en charge les protocoles NMEA, UBX, SBF, UNI, QGC, "
"RTCM3, NTRIP, SPARTN et RINEX."

